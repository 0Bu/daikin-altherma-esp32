# ESP-IDF build output
build/
sdkconfig
sdkconfig.old

# IDF Component Manager
managed_components/

# Flash artifacts
*.bin
*.elf
*.map

# …but DO ship the web-installer firmware served by GitHub Pages
!docs/*.bin

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Editor
.vscode/settings.json
.idea/
*.swp
*~

# macOS
.DS_Store

# Sensitive — never commit real credentials
sdkconfig.local
secrets.env

# OTA / Secure Boot signing keys — the private key lives OFFLINE and, in CI, only ever
# as a transient file written from the OTA_SIGNING_KEY secret. NEVER commit a real key.
*.pem
ota_signing_key.pem

# Host mock build variant
/build_mock/

# Compiler cache (scripts/ci-build-all.sh; in CI it is restored/saved by the build workflow, and
# it has to live inside the workspace because the build runs in the ESP-IDF container)
/.ccache/

# GitHub Pages site assembled by scripts/build-pages.sh
/_site/

# Release artifacts staged by scripts/ci-build-all.sh (the manifest and the .sha256 sidecars are not
# covered by the global *.bin / *.elf rules above)
/dist/

# Trusted-build handoff generated from the currently published OTA feed before dist/ is assembled.
/ota-changelog.json
