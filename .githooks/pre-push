#!/usr/bin/env bash
# Git pre-push hook for daikin-altherma-esp32.
# Enforces skill drift audit, protected branch rules, and PR policy evidence before push.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Allow emergency bypass if explicitly requested
if [ "${AGENT_PR_GATES_SKIP:-0}" = "1" ]; then
    echo "WARNING: AGENT_PR_GATES_SKIP=1 set; bypassing pre-push checks." >&2
    exit 0
fi

remote_name="${1:-origin}"
remote_url="${2:-}"
zero_sha="0000000000000000000000000000000000000000"

updates=()
if [ ! -t 0 ]; then
    while read -r local_ref local_sha remote_ref remote_sha; do
        updates+=("$local_ref $local_sha $remote_ref $remote_sha")
    done
fi

current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

# If invoked without stdin lines (e.g. manual verification)
if [ "${#updates[@]}" -eq 0 ]; then
    if [ -z "$current_branch" ] || [ "$current_branch" = "HEAD" ]; then
        echo "BLOCKED by pre-push: cannot determine branch to verify from detached HEAD." >&2
        exit 1
    fi
    if [ "$current_branch" = "main" ] || [ "$current_branch" = "master" ]; then
        echo "BLOCKED by pre-push: direct push to $current_branch branch is prohibited; open a pull request instead." >&2
        exit 1
    fi
    head_sha="$(git rev-parse HEAD 2>/dev/null || echo "")"
    updates+=("refs/heads/$current_branch $head_sha refs/heads/$current_branch $zero_sha")
fi

head_sha="$(git rev-parse HEAD 2>/dev/null || echo "")"

for update in "${updates[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha <<< "$update"

    # Skip branch deletions
    if [ "$local_sha" = "$zero_sha" ]; then
        case "$remote_ref" in
            refs/heads/main|refs/heads/master|refs/heads/gh-pages|refs/heads/HEAD)
                echo "BLOCKED by pre-push: deletion of protected branch '$remote_ref' is prohibited." >&2
                exit 1
                ;;
        esac
        continue
    fi

    # Block direct push to destination main or master
    case "$remote_ref" in
        refs/heads/main|main|refs/heads/master|master)
            echo "BLOCKED by pre-push: direct push to destination $remote_ref is prohibited; open a pull request instead." >&2
            exit 1
            ;;
    esac

    # Block push from local main or master
    case "$local_ref" in
        refs/heads/main|main|refs/heads/master|master)
            echo "BLOCKED by pre-push: direct push from $local_ref branch is prohibited; open a pull request instead." >&2
            exit 1
            ;;
    esac

    # Check PR policy gates (skill-audit and pr-hygiene-review) via require-pr-gates.sh
    local_branch="${local_ref#refs/heads/}"
    remote_branch="${remote_ref#refs/heads/}"
    if [ "$local_branch" = "$remote_branch" ]; then
        push_cmd="git push $remote_name $remote_branch"
    else
        push_cmd="git push $remote_name $local_branch:$remote_branch"
    fi

    push_payload="$(python3 - "$root" "$push_cmd" <<'PY'
import json, sys
root, cmd = sys.argv[1], sys.argv[2]
print(json.dumps({
    "conversationId": "git-cli",
    "workspacePaths": [root],
    "toolCall": {
        "name": "run_command",
        "args": {
            "CommandLine": cmd,
            "Cwd": root
        }
    }
}))
PY
)"

    if ! printf '%s' "$push_payload" | bash "$root/tools/agent-hooks/require-pr-gates.sh"; then
        echo "BLOCKED by pre-push: PR policy gates not satisfied for '$push_cmd' (target '$remote_ref' @ $local_sha)." >&2
        echo "Ensure checklist gates (\$skill-audit, \$pr-hygiene-review) are checked in your PR body before pushing." >&2
        echo "To bypass in an emergency: AGENT_PR_GATES_SKIP=1 git push ..." >&2
        exit 1
    fi
done

exit 0
