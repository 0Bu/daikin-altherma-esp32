menu "Daikin Altherma Configuration"

    comment "All of these are ALSO settable at runtime in the web UI (stored in NVS, which"
    comment "overrides these). These are only the first-boot compile-time defaults."

    # ── WiFi ──────────────────────────────────────────────────────────────────
    config DAIKIN_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID of the WiFi network to connect to. Leave empty to boot into the SoftAP
            setup portal ("daikin-altherma-esp32-setup") on first start, where WiFi can be
            entered from a phone (captive portal).

    config DAIKIN_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            Password for the WiFi network.

    config DAIKIN_HOSTNAME
        string "Hostname (mDNS)"
        default "daikin-altherma-esp32"
        help
            mDNS/host name — the device is reachable at http://<hostname>.local.



    # ── Heat-pump link (X10A) ─────────────────────────────────────────────────
    config DAIKIN_PROTOCOL
        string "Heat-pump protocol (I or S)"
        default "I"
        help
            "I" for modern Altherma units (default). "S" for older units (~2010 and earlier)
            that reply 0x15 0xEA to protocol-I requests. Settable at runtime.

    config DAIKIN_RX_PIN
        int "X10A RX GPIO (heat pump TX -> ESP RX)"
        default 44
        help
            GPIO wired to X10A pin 2 (the heat pump's TX). Default 44 (XIAO ESP32-S3 pad D7).
            This is only the first-boot default: a runtime override (web UI) is persisted
            and tried first, so custom wiring survives reboot.

    config DAIKIN_TX_PIN
        int "X10A TX GPIO (ESP TX -> heat pump RX)"
        default 43
        help
            GPIO wired to X10A pin 3 (the heat pump's RX). Default 43 (XIAO ESP32-S3 pad D6).

    # ── MQTT / Home Assistant ─────────────────────────────────────────────────
    config DAIKIN_MQTT_BROKER_URI
        string "MQTT broker URI (Home Assistant)"
        default ""
        help
            MQTT broker for the Home Assistant bridge, e.g. "mqtt://203.0.113.27:1883". A bare
            "host:port" is also accepted. Empty = MQTT disabled. NVS "mqtt_uri" overrides this.

    config DAIKIN_MQTT_USERNAME
        string "MQTT username (optional)"
        default ""

    config DAIKIN_MQTT_PASSWORD
        string "MQTT password (optional)"
        default ""

    config DAIKIN_MQTT_DISCOVERY_PREFIX
        string "Home Assistant MQTT discovery prefix"
        default "homeassistant"
        help
            Discovery topic prefix HA listens on. Default "homeassistant" matches the stock
            Home Assistant MQTT integration.

    config DAIKIN_MQTT_BASE_TOPIC
        string "MQTT base topic prefix"
        default "daikin-altherma-esp32"
        help
            Prefix for state topics. The per-device node id is appended, e.g.
            "daikin-altherma-esp32/daikin_a1b2c3/state".

    # ── OTA ───────────────────────────────────────────────────────────────────
    config DAIKIN_OTA_MANIFEST_URL
        string "OTA manifest URL"
        default "https://0bu.github.io/daikin-altherma-esp32/manifest.json"
        help
            HTTPS URL of the manifest.json published by CI. Its "version" field is compared
            against the running firmware to decide whether an update is available.

    config DAIKIN_OTA_FIRMWARE_BASE_URL
        string "OTA firmware base URL (directory)"
        default "https://0bu.github.io/daikin-altherma-esp32/"
        help
            HTTPS base URL (with trailing slash) where per-target images are published. The
            device appends "daikin-altherma-esp32<suffix>.bin" for its own chip.

    # ── Status LED ────────────────────────────────────────────────────────────
    config DAIKIN_STATUS_LED_ENABLE
        bool "Enable Status LED indicator"
        default y
        help
            Blink the onboard LED to show the system status. "ON" is the driven level, which
            DAIKIN_STATUS_LED_INVERTED flips (so solid-healthy reads as a dark LED on an
            active-low board). The six states status_led_tick() drives:
            - Slow blinking (1s ON / 1s OFF): Running SoftAP (setup portal).
            - Fast blinking (100ms ON / 100ms OFF): Connecting to WiFi.
            - Solid ON: Connected and running healthy — WiFi + X10A OK, and MQTT connected
              or not configured (an unconfigured broker is not a fault).
            - Double flash (mostly OFF, two short flashes): X10A poll error / timeout.
            - Medium blinking (300ms ON / 300ms OFF): X10A OK, but MQTT is configured and
              not connected.
            - OFF: no WiFi mode / WiFi disabled.
            X10A-down outranks MQTT-down: with both down the LED double-flashes and never
            shows the medium blink — the bus is the point of the device.

    config DAIKIN_STATUS_LED_GPIO
        int "Status LED GPIO pin"
        depends on DAIKIN_STATUS_LED_ENABLE
        default 21
        help
            GPIO pin of the status LED. Set to -1 to disable, or match your board's onboard LED.
            On Seeed XIAO ESP32-S3 it is 21.

    config DAIKIN_STATUS_LED_INVERTED
        bool "Invert LED state (Active Low)"
        depends on DAIKIN_STATUS_LED_ENABLE
        default y
        help
            Invert the LED logic. On Seeed XIAO boards, the built-in LED is Active Low
            (GPIO Low = LED ON).

    # ── SNTP (wall clock) ────────────────────────────────────────────────────
    config DAIKIN_NTP_SERVER
        string "NTP server (SNTP time sync)"
        default "pool.ntp.org"
        help
            First-boot default for the server the SNTP client polls once online, giving syslog's
            TIMESTAMP field and /status.ntp a real UTC clock instead of only uptime-since-boot.
            pool.ntp.org suits every deployment this firmware targets (a home LAN with outbound
            internet) — override it here for an offline LAN's own NTP server, or at runtime in the
            web UI (NVS "ntp_server" overrides this, same as WiFi/MQTT/syslog).

    # ── Syslog ────────────────────────────────────────────────────────────────
    config DAIKIN_SYSLOG_HOST
        string "Syslog server host/IP"
        default ""
        help
            IP address or hostname of the Syslog server. Empty = Syslog disabled.
            NVS "syslog_host" overrides this.

    config DAIKIN_SYSLOG_PORT
        int "Syslog server port"
        default 514
        help
            Port of the Syslog server (usually 514). NVS "syslog_port" overrides this.

endmenu

