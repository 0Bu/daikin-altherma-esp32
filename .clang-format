# Style spec for daikin-altherma-esp32 first-party C/C++ (main/, test/). It does NOT apply to
# managed_components/ (vendored, regenerated — never reformat) or generated def profiles.
#
# 4-space indent, attached braces, left-aligned pointers, no namespace indent, aligned
# assignments/declarations/trailing comments, short funcs kept on one line — matched to the
# hand-formatted sources to minimize churn.
#
# The .claude/hooks/clang-format-edit.sh hook honours this only where clang-format is
# installed. VERIFY CHURN ONCE before relying on auto-format:
#     clang-format --dry-run -Werror main/*.cpp main/*.hpp main/logic/*.hpp test/*.cpp
---
Language:        Cpp
BasedOnStyle:    LLVM
IndentWidth:     4
TabWidth:        4
UseTab:          Never
ColumnLimit:     100

PointerAlignment:       Left
DerivePointerAlignment: false
NamespaceIndentation:   None
AccessModifierOffset:   -4
BreakBeforeBraces:      Attached
IndentCaseLabels:       false
Cpp11BracedListStyle:   true
SpaceBeforeParens:      ControlStatements

AllowShortFunctionsOnASingleLine:   All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine:        true
AllowShortBlocksOnASingleLine:       Empty

AlignAfterOpenBracket:        Align
AlignTrailingComments:        true
AlignConsecutiveAssignments:  true
AlignConsecutiveDeclarations: true

SortIncludes:                 false
FixNamespaceComments:         true
KeepEmptyLinesAtTheStartOfBlocks: false
MaxEmptyLinesToKeep:          1
